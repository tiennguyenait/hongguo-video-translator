# OpenAI-compatible translation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Required for local pyannote speaker diarization. Accept the model terms first:
# https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Server defaults for uploads that send minimal/empty options payload
HONGGUO_DEFAULT_PROVIDER=deepseek
HONGGUO_DEFAULT_TRANSLATION_DRAFT_PROVIDER=deepseek
HONGGUO_DEFAULT_TRANSLATION_REFINER_PROVIDER=auto
HONGGUO_DEFAULT_ASR_MODEL=qwen3-asr-1.7b
HONGGUO_DEFAULT_DIARIZE=true
HONGGUO_DEFAULT_MIN_SPEAKERS=
HONGGUO_DEFAULT_MAX_SPEAKERS=6
HONGGUO_DEFAULT_SOURCE_LANGUAGE_CODE=zh
HONGGUO_DEFAULT_SOURCE_LANGUAGE=Chinese
HONGGUO_DEFAULT_TARGET_LANGUAGE=Vietnamese
HONGGUO_DEFAULT_BURN_SUBTITLES=true
HONGGUO_DEFAULT_HIDE_SOURCE_SUBTITLES=false
HONGGUO_DEFAULT_DUB=true
HONGGUO_DEFAULT_TTS_VOICE="Ngọc Huyền — authorized clone"
HONGGUO_DEFAULT_ORIGINAL_AUDIO_VOLUME=0.08
HONGGUO_DEFAULT_WATERMARK_OPACITY=0.58
HONGGUO_DEFAULT_CHANNEL_NAME=
HONGGUO_DEFAULT_CHANNEL_LOGO=
HONGGUO_TTS_SENTENCE_GAP_BREAK_SECONDS=0.8
HONGGUO_TTS_LONG_UTTERANCE_WARNING_MS=14000
